# Copy this file to `.env` and fill in the values you need.
# See Test/Manual/Ocr/TestLinear_setup.md for how to obtain the Bedrock key.

# --- Amazon Bedrock ---
# Short-term API key (valid up to 12h). Required only if a role below
# (OCR_PROVIDER / CLIPPER_PROVIDER) is set to "bedrock". If left unset,
# boto3's normal credential resolution (env vars, ~/.aws/credentials,
# profile, instance role) is used instead.
AWS_BEDROCK_SHORT_API_KEY=xxx
# Bedrock region. Must match the region the short-term key above was issued
# for. Default: us-west-2
AWS_REGION=ap-northeast-1

# --- OpenAI ---
# Required only if a role below is set to "openai".
OPENAI_API_KEY=xxx

# --- Linear OCR pipeline (Test/Manual/Ocr/TestLinear.py) ---
# Which provider each role runs on: "bedrock" or "openai".
# Default: OCR_PROVIDER=openai, CLIPPER_PROVIDER=bedrock (Bedrock's Qwen
# models don't support the forced tool_choice the OCR agent's structured
# final response depends on).
OCR_PROVIDER=openai
CLIPPER_PROVIDER=bedrock

# Model id for each role. Optional - each provider has its own default
# (see DEFAULT_MODEL_IDS in TestLinear.py) if left unset. For Bedrock this
# may need to be a fully qualified inference profile id (e.g. prefixed with
# a region, like "jp.anthropic.claude-sonnet-4-6").
OCR_MODEL_ID=gpt-5.6-luna
CLIPPER_MODEL_ID=qwen.qwen3-vl-235b-a22b

# Verbosity of OcrModule.Linear's logging (model output, tool calls/results),
# written to Test/Manual/Ocr/Output/TestLinear.log. One of DEBUG/INFO/WARNING/ERROR.
# Default: INFO
LOG_LEVEL=INFO
